# Copy to frontend/.env (gitignored). Vite only exposes variables prefixed VITE_.

# Where the Vite DEV SERVER proxies /api requests (local development only).
VITE_API_PROXY_TARGET=http://localhost:8000

# API base URL used by the browser code. Leave EMPTY for same-origin (/api via proxy).
# Set only for the app./api. subdomain deployment option, e.g. https://api.example.com
VITE_API_BASE_URL=
