# Copy this file to .env and fill in values. .env is gitignored.

# ---- Django ----
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=true
# Comma-separated hostnames the API will serve (port is ignored)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Same-origin API access ----
# The SPA reaches the API at /api on ITS OWN origin:
#   local:  Vite dev server proxies /api -> Django (see frontend/vite.config.js)
#   prod:   the frontend host (Vercel/Netlify rewrites) proxies /api -> backend host,
#           OR app.<domain> / api.<domain> subdomains are used (same-site cookies).
# Because of that, CORS and CSRF trusted origins are normally EMPTY. Fill them only for
# the subdomain deployment option, and always with explicit origins (never "*").
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# ---- Auth cookies / tokens ----
# Refresh token cookie. Secure defaults to "not DEBUG"; set explicitly to override.
# AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
# Only for the app./api. subdomain option, e.g. ".example.com"
# AUTH_COOKIE_DOMAIN=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# ---- Production hardening (applied only when DJANGO_DEBUG=false) ----
# Production refuses to start unless DJANGO_SECRET_KEY is 50+ random characters.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Move Django admin off the well-known /admin/ path, e.g. staff-7f3k2/
DJANGO_ADMIN_URL=admin/
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# Turn these on only once every subdomain of your domain is HTTPS-only:
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false
# Extra "other" documents a homeowner may attach per application
MAX_OTHER_DOCUMENTS=25

# ---- Reverse proxy (production only, behind a trusted proxy such as Render/Railway/Fly) ----
# Number of trusted proxies; DRF uses X-Forwarded-For for client IP (throttling) when > 0.
DJANGO_NUM_PROXIES=0
# Trust X-Forwarded-Proto for https detection (needed for Secure cookies behind a proxy)
DJANGO_USE_X_FORWARDED_PROTO=false

# ---- PostgreSQL (used by docker-compose AND Django) ----
POSTGRES_DB=ready2rent
POSTGRES_USER=ready2rent
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Django reads DATABASE_URL if set; otherwise it is built from POSTGRES_* above.
# Production (Supabase) uses the SESSION POOLER URI, which works over IPv4:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Seconds to keep a database connection open for reuse (connections are health-checked first)
# DB_CONN_MAX_AGE=60

# ---- Redis (cache, throttling, Celery broker) ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Celery broker defaults to REDIS_URL with database 1. Override for a separate instance.
# CELERY_BROKER_URL=redis://localhost:6379/1
# Run tasks inline in the web process (no worker). Useful on a host without a worker dyno.
CELERY_TASK_ALWAYS_EAGER=false
# Seconds a cached ops queue page may live (writes invalidate sooner)
OPS_QUEUE_CACHE_SECONDS=60

# ---- Email (notifications) ----
# Local default prints emails to the Celery worker's terminal. Production SMTP needs Gate 4.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Ready2Rent <no-reply@ready2rent.local>
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# Public URL of the React app, used for links inside emails
FRONTEND_URL=http://localhost:5173

# ---- Uploaded documents ----
# Unset locally: files go to backend/media. In production, set all four to use a PRIVATE
# Supabase Storage bucket through its S3 API (Project Settings -> Storage -> S3).
# The S3 keys bypass Supabase access rules: server-side only, never in the frontend.
# SUPABASE_S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=us-west-2
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# SUPABASE_STORAGE_BUCKET=documents
